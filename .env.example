# =============================================
# 公共路径配置示例（复制为 .env 后按实际环境修改）
# =============================================

# HTTP 接口基础路径（axios 请求统一使用）
VITE_API_BASE_URL=http://192.168.100.115:8080

# WebSocket 基础地址（聊天实时通信使用，chat.ts 会自动拼接 /ws/chat?token=xxx）
VITE_WS_BASE_URL=ws://192.168.100.115:8080

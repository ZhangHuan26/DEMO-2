export const MOCK_ARTICLES: Article[] = ARTICLE_PRESET_IMAGES.slice(0, 8).map((preset, idx) => ({
  id: idx + 1,
  userId: (idx % MOCK_CREATORS.length) + 1,
  title: `${preset.title} — 2026 创意视觉实验探索`,
  content: `## 艺术概念\n\n该作品探索了 **${preset.tag}** 领域中高饱和色彩与空间构图的深度平衡。\n\n利用现代渲染引擎与几何拓扑结构，构建出极具冲击力的视觉效果。\n\n### 设计要素\n- 高阶渐变流体\n- 光影质感折射\n- 极简版式与多语言字体搭配`,
  summary: `基于 ${preset.tag} 主题的深度创意视觉实验，展示极简主义与前沿色彩的碰撞。`,
  coverImage: preset.url,
  categoryId: (idx % 5) + 1,
  categoryName: preset.tag,
  viewCount: 1240 + idx * 310,
  likeCount: 380 + idx * 85,
  favoriteCount: 190 + idx * 42,
  commentCount: 24 + idx * 5,
  status: 0,
  isHidden: 0,
  author: MOCK_CREATORS[idx % MOCK_CREATORS.length],
  createdAt: new Date(Date.now() - idx * 86400000).toISOString(),
}));

